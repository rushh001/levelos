    "word": ["மரம்", "ஆடு", "மயில்", "காது", "வீடு", "மலை", "குடை", "கடல்", "பால்", "எலி", "மீன்", "மாடு", "கதவு", "காகம்", "பூனை", "கண்", "கிளி", "குதிரை", "கோழி", "நாய்", "நிலா", "யானை", "பசு", "புலி", "கரடி", "முயல்", "மான்", "தவளை", "ஆமை", "நரி", "அணில்", "தேனீ", "சேவல்", "குருவி", "புறா", "கால்", "வாய்", "தலை", "முடி", "பல்", "விரல்", "உதடு", "இலை", "பழம்", "வாழை", "தேன்", "சோறு", "மோர்", "தயிர்", "நெய்", "கீரை", "வடை", "தோசை", "புளி", "கடலை", "பாய்", "மழை", "வெயில்", "மேகம்", "வானம்"]
