    },
    {
      "id": "ta-para-j",
      "level": "paragraph",
      "title": "பச்சைக் கிளி",
      "sentences": ["மரத்தில் ஒரு கிளி.", "அதன் நிறம் பச்சை.", "கிளி பழம் தின்னும்.", "அது அழகாக பேசும்."]
    },
    {
      "id": "ta-story-c",
      "level": "story",
      "title": "காகிதக் கப்பல்",
      "sentences": ["இன்று நல்ல மழை பெய்தது.", "கவின் வீட்டில் இருந்தான்.", "அவன் ஒரு காகிதக் கப்பல் செய்தான்.", "தங்கை மீனாவும் ஒரு கப்பல் செய்தாள்.", "மழை நின்றதும் இருவரும் வெளியே வந்தனர்.", "தெருவில் தண்ணீர் ஓடியது.", "அவர்கள் கப்பல்களை நீரில் விட்டனர்.", "கப்பல்கள் வேகமாக மிதந்து சென்றன.", "இருவரும் கை தட்டிச் சிரித்தனர்."]
    },
    {
      "id": "ta-story-d",
      "level": "story",
      "title": "பஞ்சு பூனைக்குட்டி",
      "sentences": ["செல்வியின் வீட்டுக்கு ஒரு பூனைக்குட்டி வந்தது.", "அது வெள்ளை நிறத்தில் இருந்தது.", "அது மியாவ் மியாவ் என்று கத்தியது.", "அதற்குப் பசி என்று செல்விக்குப் புரிந்தது.", "அவள் ஒரு கிண்ணத்தில் பால் வைத்தாள்.", "பூனைக்குட்டி பாலை வேகமாகக் குடித்தது.", "பிறகு அது செல்வியின் காலருகே படுத்தது.", "செல்வி அதற்குப் பஞ்சு என்று பெயர் வைத்தாள்.", "இப்போது பஞ்சு அவள் வீட்டிலேயே இருக்கிறது."]
    },
    {
      "id": "ta-story-e",
      "level": "story",
      "title": "சின்ன விதை",
      "sentences": ["லதா ஒரு அவரை விதை நட்டாள்.", "தினமும் அதற்குத் தண்ணீர் ஊற்றினாள்.", "சில நாள் ஒன்றும் வரவில்லை.", "லதா பொறுமையாகக் காத்திருந்தாள்.", "ஒரு நாள் காலையில் ஒரு சின்ன இலை தெரிந்தது.", "லதா அம்மாவைக் கூப்பிட்டுக் காட்டினாள்.", "செடி நாளுக்கு நாள் வளர்ந்தது.", "பிறகு அதில் நிறைய அவரைக்காய் காய்த்தன.", "அன்று அம்மா அவரைக்காய் பொரியல் செய்தாள்."]
    },
    {
      "id": "ta-story-f",
      "level": "story",
      "title": "பகிர்ந்த சோறு",
      "sentences": ["பாலு பள்ளிக்குச் சென்றான்.", "அவன் சாப்பாட்டுப் பையை வீட்டில் மறந்துவிட்டான்.", "மதியம் எல்லோரும் சாப்பிட அமர்ந்தனர்.", "பாலு அமைதியாக உட்கார்ந்திருந்தான்.", "அவன் நண்பன் ரவி அதைப் பார்த்தான்.", "ரவி தன் சோற்றைப் பாலுவுடன் பகிர்ந்தான்.", "கனி தன் வாழைப்பழத்தைக் கொடுத்தாள்.", "பாலுவின் வயிறு நிறைந்தது.", "அவன் நண்பர்களுக்கு நன்றி சொன்னான்."]
    },
    {
      "id": "ta-story-g",
      "level": "story",
      "title": "புதிய கன்றுக்குட்டி",
      "sentences": ["எங்கள் வீட்டில் ஒரு கன்றுக்குட்டி பிறந்தது.", "அது பழுப்பு நிறத்தில் இருந்தது.", "முதலில் அதனால் நிற்க முடியவில்லை.", "பிறகு மெதுவாக எழுந்து நின்றது.", "அது அம்மா பசுவிடம் பால் குடித்தது.", "நானும் தம்பியும் அதைப் பார்த்துக்கொண்டே இருந்தோம்.", "மறுநாள் அது முற்றத்தில் துள்ளி ஓடியது.", "நாங்கள் அதற்குச் சின்னு என்று பெயர் வைத்தோம்."]
    },
    {
      "id": "ta-story-h",
      "level": "story",
      "title": "மீனாவின் மிதிவண்டி",
      "sentences": ["மீனாவுக்கு மிதிவண்டி ஓட்டத் தெரியாது.", "அப்பா அவளுக்குச் சொல்லித் தந்தார்.", "அப்பா பின்னால் வண்டியைப் பிடித்துக்கொண்டார்.", "மீனா மெதுவாக மிதித்தாள்.", "வண்டி அங்கும் இங்கும் ஆடியது.", "அவள் பல நாள் பழகினாள்.", "ஒரு நாள் அப்பா கையை விட்டுவிட்டார்.", "மீனா தானே ஓட்டிச் சென்றாள்.", "அவள் மகிழ்ச்சியில் மணி அடித்தாள்."]
    }
  ]
