    { "id": "ta-word-a", "level": "word", "units": ["மரம்", "ஆடு", "மயில்", "காது", "வீடு"] },
    { "id": "ta-word-b", "level": "word", "units": ["மலை", "குடை", "கடல்", "பால்", "எலி"] },
    { "id": "ta-word-c", "level": "word", "units": ["மீன்", "மாடு", "கதவு", "காகம்", "பூனை"] },
    { "id": "ta-para-a", "level": "paragraph", "title": "மீனாவின் பூனை", "sentences": ["என் பெயர் மீனா.", "என்னிடம் ஒரு பூனை உள்ளது.", "பூனையின் நிறம் கருப்பு.", "அது தினமும் பால் குடிக்கும்."] },
    { "id": "ta-para-b", "level": "paragraph", "title": "காகிதப் படகு", "sentences": ["இன்று நிறைய மழை பெய்தது.", "தெருவில் தண்ணீர் தேங்கியது.", "ராமு காகிதப் படகு செய்தான்.", "படகு தண்ணீரில் மிதந்தது."] },
    { "id": "ta-story-a", "level": "story", "title": "சந்தையில் மோனு", "sentences": ["சோனுவுக்கு ஒரு தம்பி இருக்கிறான்.", "அவன் பெயர் மோனு.", "ஒரு நாள் இருவரும் சந்தைக்குச் சென்றனர்.", "சந்தையில் நிறைய கூட்டம் இருந்தது.", "மோனு பலூன் விற்பவரைப் பார்த்தான்.", "அவன் பலூன் வாங்க ஓடி, கூட்டத்தில் தொலைந்து போனான்.", "சோனு மிகவும் பயந்தான்.", "அவன் மோனுவை எல்லா இடத்திலும் தேடினான்.", "மோனு பலூன் விற்பவர் அருகே நின்றுகொண்டிருந்தான்.", "சோனு அவனைக் கட்டி அணைத்துக்கொண்டான்."] },
    { "id": "ta-story-b", "level": "story", "title": "மாமரம்", "sentences": ["ராணியின் வீட்டுக்கு அருகில் ஒரு தோட்டம் உள்ளது.", "தோட்டத்தில் ஒரு பெரிய மாமரம் உள்ளது.", "கோடையில் மரத்தில் நிறைய மாம்பழங்கள் காய்க்கும்.", "ஒரு நாள் ராணி தன் தோழியுடன் தோட்டத்திற்குச் சென்றாள்.", "இருவரும் மரத்தடியில் அமர்ந்து மாம்பழம் சாப்பிட்டனர்.", "அப்போது ஒரு குரங்கு மரத்திலிருந்து கீழே இறங்கியது.", "குரங்கு ராணியின் மாம்பழத்தைப் பறித்துக்கொண்டு ஓடியது.", "இரண்டு தோழிகளும் சத்தமாகச் சிரித்தனர்."] },

    {
      "id": "ta-para-c",
      "level": "paragraph",
      "title": "மழை நாள்",
      "sentences": ["இன்று மழை பெய்தது.", "தெருவில் தண்ணீர் ஓடியது.", "நான் குடை எடுத்தேன்.", "பள்ளிக்கு நடந்து சென்றேன்."]
    },
    {
      "id": "ta-para-d",
      "level": "paragraph",
      "title": "ரவியின் பசு",
      "sentences": ["ரவியிடம் ஒரு பசு உள்ளது.", "பசுவின் நிறம் வெள்ளை.", "அது புல் தின்னும்.", "பசு நிறைய பால் தரும்."]
    },
