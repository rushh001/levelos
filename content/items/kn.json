    { "id": "kn-para-a", "level": "paragraph", "title": "ಮೀನಾಳ ಬೆಕ್ಕು", "sentences": ["ನನ್ನ ಹೆಸರು ಮೀನಾ.", "ನನ್ನ ಬಳಿ ಒಂದು ಬೆಕ್ಕು ಇದೆ.", "ಬೆಕ್ಕಿನ ಬಣ್ಣ ಕಪ್ಪು.", "ಅದು ದಿನವೂ ಹಾಲು ಕುಡಿಯುತ್ತದೆ."] },
    { "id": "kn-para-b", "level": "paragraph", "title": "ಕಾಗದದ ದೋಣಿ", "sentences": ["ಇಂದು ತುಂಬಾ ಮಳೆ ಬಂತು.", "ಅಂಗಳದಲ್ಲಿ ನೀರು ನಿಂತಿತು.", "ರಾಮು ಕಾಗದದ ದೋಣಿ ಮಾಡಿದನು.", "ದೋಣಿ ನೀರಿನಲ್ಲಿ ತೇಲತೊಡಗಿತು."] },
    { "id": "kn-story-a", "level": "story", "title": "ಸಂತೆಯಲ್ಲಿ ಮೋನು", "sentences": ["ಸೋನುವಿಗೆ ಒಬ್ಬ ತಮ್ಮ ಇದ್ದಾನೆ.", "ಅವನ ಹೆಸರು ಮೋನು.", "ಒಂದು ದಿನ ಇಬ್ಬರೂ ಸಂತೆಗೆ ಹೋದರು.", "ಸಂತೆಯಲ್ಲಿ ತುಂಬಾ ಜನ ಇದ್ದರು.", "ಮೋನು ಬಲೂನು ಮಾರುವವನನ್ನು ನೋಡಿದನು.", "ಅವನು ಬಲೂನಿಗಾಗಿ ಓಡಿ ಜನರ ನಡುವೆ ಕಳೆದುಹೋದನು.", "ಸೋನುವಿಗೆ ತುಂಬಾ ಭಯವಾಯಿತು.", "ಅವನು ಮೋನುವನ್ನು ಎಲ್ಲ ಕಡೆ ಹುಡುಕಿದನು.", "ಮೋನು ಬಲೂನು ಮಾರುವವನ ಹತ್ತಿರ ನಿಂತಿದ್ದನು.", "ಸೋನು ಅವನನ್ನು ಅಪ್ಪಿಕೊಂಡನು."] },
    { "id": "kn-story-b", "level": "story", "title": "ಮಾವಿನ ಮರ", "sentences": ["ರಾಣಿಯ ಮನೆಯ ಹತ್ತಿರ ಒಂದು ತೋಟ ಇದೆ.", "ತೋಟದಲ್ಲಿ ಒಂದು ದೊಡ್ಡ ಮಾವಿನ ಮರ ಇದೆ.", "ಬೇಸಿಗೆಯಲ್ಲಿ ಮರದಲ್ಲಿ ತುಂಬಾ ಹಣ್ಣುಗಳು ಬಿಡುತ್ತವೆ.", "ಒಂದು ದಿನ ರಾಣಿ ತನ್ನ ಗೆಳತಿಯ ಜೊತೆ ತೋಟಕ್ಕೆ ಹೋದಳು.", "ಇಬ್ಬರೂ ಮರದ ಕೆಳಗೆ ಕುಳಿತು ಮಾವಿನ ಹಣ್ಣು ತಿಂದರು.", "ಆಗ ಒಂದು ಕೋತಿ ಮರದಿಂದ ಕೆಳಗೆ ಇಳಿಯಿತು.", "ಕೋತಿ ರಾಣಿಯ ಹಣ್ಣನ್ನು ಕಸಿದುಕೊಂಡು ಓಡಿತು.", "ಇಬ್ಬರು ಗೆಳತಿಯರೂ ಜೋರಾಗಿ ನಕ್ಕರು."] },

