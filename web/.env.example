# Copy to web/.env for production builds. Leave empty in dev (Vite proxies /api to localhost:8000).
VITE_API_BASE=
# Optional: LM Studio's local server, used for offline activities on a computer that runs it (default below).
# In LM Studio: load a model, start the local server (Developer tab) and turn on "Enable CORS".
VITE_LMSTUDIO_URL=http://localhost:1234
