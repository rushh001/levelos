# Template only: keep every value below EMPTY in this file (it is committed; a test enforces it).
# Put real values in api/.env.local (gitignored), which overrides api/.env.

APP_ENV=dev
# Local dev default is SQLite. Production: Neon Postgres URL (postgresql://... is auto-converted to the psycopg driver)
DATABASE_URL=sqlite:///./levelos.db
# Any long random string. Empty in dev = an insecure built-in default; production refuses to start without one.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# Claude (required — diagnosis, activity generation, validation)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_VALIDATOR_MODEL=claude-haiku-5-5

# Speech path A — Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Speech path B — Azure Speech (F0 tier; region e.g. centralindia)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Speech path C — Gemini (optional, AI Studio key)
GEMINI_API_KEY=

# Keep raw audio after scoring? false = delete (default). Only true for the consented eval set.
KEEP_AUDIO=false

# The hosted demo's database (Neon, created from Vercel > Storage), used only to run maintenance scripts from this
# machine (seed, Claude diagnoses for the demo class, spend report). Direct / unpooled URL. Keep it out of the repo.
PROD_DATABASE_URL=
